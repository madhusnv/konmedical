<header>
  <div class="container">
    <nav>
      <a class="brand" href="/" aria-label="Konfido Education & Training PVT Ltd">
        <img src="/logo.webp" alt="Konfido Education & Training PVT Ltd logo" width="137" height="54" />
        <span>
          Konfido Education &amp; Training PVT Ltd
          <small>Overseas MBBS Admissions · Hyderabad</small>
        </span>
      </a>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu">☰</button>
      <ul class="nav-links" id="navLinks">
