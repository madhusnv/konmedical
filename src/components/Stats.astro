---
const stats = [
  { value: '6+', label: 'Partner Universities' },
  { value: '500+', label: 'Students Guided' },
  { value: '2', label: 'Countries — Vietnam & Georgia' },
  { value: '100%', label: 'Admission Support' },
];
---

<div class="stats">
  <div class="container">
    {stats.map((s) => (
      <div class="stat">
        <b>{s.value}</b>
        <span>{s.label}</span>
      </div>
    ))}
  </div>
</div>
